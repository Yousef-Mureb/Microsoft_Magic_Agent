# Copy to .env and fill in. Names only here; .env is ignored by git.

# Comma-separated client keys accepted in the x-api-key header (development only;
# Azure Key Vault at a later step). The server refuses to start without at least one key.
MS_AGENT_API_KEYS=

# Public base address the agent card advertises; the JSON-RPC endpoint must be on this host.
MS_AGENT_PUBLIC_URL=http://localhost:8080

# Azure OpenAI. With the key empty, the agent signs in with the managed identity AZURE_CLIENT_ID
# (role Cognitive Services OpenAI User on the account), so the deployed app holds no key.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_CLIENT_ID=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional cap on generated tokens, sent as max_completion_tokens; for a reasoning model it
# includes reasoning tokens, so leave it empty unless you need it.
AZURE_OPENAI_MAX_COMPLETION_TOKENS=

# Microsoft Learn MCP server (Model Context Protocol), used to retrieve passages
LEARN_MCP_URL=https://learn.microsoft.com/api/mcp

# Price store (SQLAlchemy URL): SQLite in development, PostgreSQL in Azure, same schema,
# e.g. postgresql+psycopg://user:password@host:5432/prices (keep the password out of this file).
MS_AGENT_PRICE_DB_URL=sqlite:///prices.sqlite3
# What jobs/refresh_prices.py pulls from the Azure Retail Prices API (case-sensitive values).
MS_AGENT_PRICE_REGIONS=uaenorth,uaecentral,westeurope,northeurope,eastus
MS_AGENT_PRICE_FAMILIES=Compute,Storage,Networking,Databases
# The designs' baseline services, by serviceName in every region; Load Balancer under armRegionName 'Global'.
MS_AGENT_PRICE_SERVICES=Application Gateway,Backup,Key Vault,Log Analytics,Microsoft Defender for Cloud,Azure Bastion,Azure Site Recovery,API Management
MS_AGENT_PRICE_GLOBAL_SERVICES=Load Balancer
# USD is the list price; AED, SAR and EUR are accepted by the API, for reference.
MS_AGENT_PRICE_CURRENCIES=USD
# VM families sizing may choose.
MS_AGENT_VM_FAMILIES=D,E,F,B

# Files the agent makes (the estimate workbook), kept 24 hours and served at /files/<id>:
# local (a folder) or blob (Azure Blob Storage, by the managed identity; also gives a 24-hour SAS link).
MS_AGENT_FILES_BACKEND=local
MS_AGENT_FILES_DIR=files
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=estimates

# Logging: DEBUG, INFO, WARNING
MS_AGENT_LOG_LEVEL=INFO
